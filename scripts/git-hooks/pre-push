#!/usr/bin/env bash
: 'hive-v2 tracked hook: scripts/git-hooks/pre-push'
case "${PRESUBMIT:-on}" in
  off|0)
    echo "!! WARNING: PRESUBMIT=${PRESUBMIT} — pushing WITHOUT the full gate. !!" >&2
    echo "!! Declare this escape in your lane pulse.                       !!" >&2
    exit 0
    ;;
esac
set -euo pipefail

if root="$(jj root 2>/dev/null)"; then
  cd "$root"
  list_scripts() { jj file list 'glob:**/*.sh'; }
else
  cd "$(git rev-parse --show-toplevel)"
  list_scripts() { git ls-files '*.sh'; }
fi

if [ ! -d node_modules ]; then
  npm ci
fi
command -v cfn-lint >/dev/null || { echo "pre-push: cfn-lint is required" >&2; exit 1; }

list_scripts | while read -r f; do
  bash -n "$f" || { echo "pre-push: bash -n failed: $f" >&2; exit 1; }
done

for f in .github/workflows/*.yml .github/workflows/*.yaml; do
  [ -e "$f" ] || continue
  python3 -c 'import sys, yaml; yaml.safe_load(open(sys.argv[1]))' "$f" \
    || { echo "pre-push: yaml parse failed: $f" >&2; exit 1; }
done

export PYTHONDONTWRITEBYTECODE=1
python3 test/deploy_workflow_checks.py
npm test
npm run build
node scripts/discipline-gate.mjs
python3 test/t01_policy_checks.py
python3 test/t01_runtime_checks.py
python3 test/t01_workflow_checks.py
python3 test/t01_lifecycle_checks.py
python3 test/t01_health_broker_checks.py
python3 test/t01_paid_infra_checks.py
python3 test/t01_count_listener_checks.py
cfn-lint infra/template.yaml infra/t01-smoke/template.yaml
