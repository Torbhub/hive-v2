[Unit]
Description=hive-v2 watch daemon (pane watchdog + auto-approver)
# After only: the tmux unit starts the server first when present, but a
# missing unit must never block this one.
After=network.target hive-v2-tmux.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hive-work
ExecStart=/usr/local/bin/hive watch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
