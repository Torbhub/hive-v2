[Unit]
Description=hive-v2 hub webapp (loopback only; nginx fronts TLS + basic auth)
# After only: the tmux unit starts the server first when present, but a
# missing unit must never block this one.
After=network.target hive-v2-tmux.service

[Service]
Type=simple
User=ubuntu
Environment=HIVE_WEB_PORT=7684
EnvironmentFile=/etc/hive-v2/web.env
WorkingDirectory=/home/ubuntu/hive-work
ExecStart=/usr/local/bin/hive web
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
