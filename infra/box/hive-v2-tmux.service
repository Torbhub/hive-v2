[Unit]
Description=hive-v2 tmux server (socket /tmp/tmux-1000/hive-v2)
# This unit owns the tmux server and its cgroup. Deploys must never restart
# it: a restart kills every agent pane. If the server dies, `systemctl start`
# it (the watch wake path does this itself); the watchdog re-wakes the panes.

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
# start-server exits when no session exists, so hold one open.
ExecStart=/usr/bin/tmux -L hive-v2 new-session -d -s server -n holder

[Install]
WantedBy=multi-user.target
