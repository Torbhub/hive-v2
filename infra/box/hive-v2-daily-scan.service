[Unit]
Description=hive-v2 daily scan (posts the daily-scan task to the hub and starts the team)
# After only: the scan needs the web API up, but a missing unit must never
# block this one.
After=network.target hive-v2-web.service

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/etc/hive-v2/web.env
ExecStart=/opt/hive-v2/daily-scan.sh
