[Unit]
Description=Run-scoped TeamKimi count-only listener
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=TEAMKIMI_DISABLE_AUTOUPDATE=1
Environment=PATH=/opt/node22/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node22/bin/node /opt/teamkimi-count/87e5ed7dc1fd7af3a234ac4e4f24b9c7286126b6/src/index.js smoke-count --state-path /var/lib/teamkimi-count/%i/ledger.json
StateDirectory=teamkimi-count/%i
StateDirectoryMode=0700
ReadOnlyPaths=/home/ubuntu /opt/teamkimi-count/87e5ed7dc1fd7af3a234ac4e4f24b9c7286126b6
ReadWritePaths=/var/lib/teamkimi-count/%i
Restart=no
RuntimeMaxSec=10800
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
